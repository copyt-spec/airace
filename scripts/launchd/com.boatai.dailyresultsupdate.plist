<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boatai.dailyresultsupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/takedanaoya/boat_ai/boat_ai/scripts/run_daily_results_update.sh</string>
        <string>--days-back</string>
        <string>2</string>
    </array>

    <!-- 毎日23:00(その日のレースが全て終わった後)に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/takedanaoya/boat_ai/boat_ai/data/logs/daily_update_run_logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/takedanaoya/boat_ai/boat_ai/data/logs/daily_update_run_logs/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
