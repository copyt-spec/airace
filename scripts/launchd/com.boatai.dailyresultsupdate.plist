<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boatai.dailyresultsupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/takedanaoya/boat_ai/boat_ai/scripts/run_daily_results_update.sh</string>
        <string>--days-back</string>
        <string>2</string>
    </array>

    <!-- 2026-07-26変更: 1日1回(23:00)だと結果反映が翌日まで遅れるため、
         12:00・17:00・23:00の1日3回に増やした(日中のレース分もこまめに
         resultsに反映し、/simが最新に近い状態を保てるようにする) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/takedanaoya/boat_ai/boat_ai/data/logs/daily_update_run_logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/takedanaoya/boat_ai/boat_ai/data/logs/daily_update_run_logs/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
